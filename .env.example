# Copy to .env and customize before local development.
# The database must already exist: CREATE DATABASE farm2home CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/farm2home
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret-before-deployment
FLASK_ENV=development
PORT=5000
SEED_DEMO_DATA=true
SCHEDULER_ENABLED=true
# Keep false for local HTTP; set true behind HTTPS in a real deployment.
SESSION_COOKIE_SECURE=false
